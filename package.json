{
  "name": "meta-leads-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/analyze-creatives.mjs",
    "data:live": "node scripts/build-data.mjs live && node scripts/analyze-creatives.mjs",
    "data:sample": "node scripts/build-data.mjs sample && node scripts/analyze-creatives.mjs",
    "creative:analyze": "node scripts/analyze-creatives.mjs",
    "creative:ai": "node scripts/ai-narrate.mjs",
    "audit": "npm run audit:data && npm run audit:meta",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:meta": "node scripts/meta-audit.mjs",
    "dev": "npm run data:sample && next dev",
    "dev:sample": "npm run data:sample && next dev",
    "dev:live": "npm run data:live && next dev",
    "build": "npm run data:sample && next build",
    "build:live": "npm run data:live && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
