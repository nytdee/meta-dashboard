# Meta Graph API (server-side only, never exposed to the browser)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
DASHBOARD_REFRESH_TOKEN=

# Optional AI narrative for Creative Intelligence.
# The dashboard always works without it: the quantitative analysis is computed
# by the rules engine. When a key is present, `npm run creative:ai` adds a short
# qualitative note per creative. The model may not output numbers, so every
# figure in the UI stays engine-generated.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
